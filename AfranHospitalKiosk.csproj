<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="DoctorWindow.xaml" />
    <Page Include="LauncherWindow.xaml" />
    <Page Include="MainWindow.xaml" />
    <Page Include="ServerManagerWindow.xaml" />
    <Page Include="TvWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\afranlogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AddisSlideshow\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Voices\Amharic\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.27" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="QueueApi\**\*.cs" />
    <Content Remove="QueueApi\**\*" />
    <None Remove="QueueApi\**\*" />
    <Compile Remove="QueueApi.Tests\**\*.cs" />
    <Content Remove="QueueApi.Tests\**\*" />
    <None Remove="QueueApi.Tests\**\*" />
  </ItemGroup>

</Project>
