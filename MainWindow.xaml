<Window x:Class="AfranHospitalKiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Afran Hospital Registration Kiosk"
        Width="1366"
        Height="768"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#10251F"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#10251F" />
        <SolidColorBrush x:Key="PaperBrush" Color="#FFFDF7" />
        <SolidColorBrush x:Key="MintBrush" Color="#BFE8D5" />
        <SolidColorBrush x:Key="ForestBrush" Color="#0D6B4F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6F64" />
        <SolidColorBrush x:Key="GoldBrush" Color="#D8A531" />

        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="MinHeight" Value="174" />
            <Setter Property="Padding" Value="28" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0" />
                        <GradientStop Color="#FFFDF7" Offset="0.56" />
                        <GradientStop Color="#EAF6EF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#10251F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <SkewTransform AngleX="0" AngleY="0" />
                        <TranslateTransform Y="0" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="14"
                                      Direction="270"
                                      Opacity="0.42"
                                      Color="#050707" />
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <EventSetter Event="MouseEnter" Handler="Component3D_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Component3D_MouseLeave" />
            <EventSetter Event="PreviewMouseDown" Handler="Component3D_MouseDown" />
            <EventSetter Event="PreviewMouseUp" Handler="Component3D_MouseUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="#F0D47A"
                                BorderThickness="1.4"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <Border CornerRadius="8"
                                        Opacity="0.74">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFFFFF" Offset="0" />
                                            <GradientStop Color="#1AFFFFFF" Offset="0.42" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.72" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Height="18"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="0,0,8,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#1F08110D" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Margin="1"
                                        CornerRadius="7"
                                        BorderThickness="1,1,1,0"
                                        BorderBrush="#B8FFFFFF" />
                                <Border Margin="0,0,0,1"
                                        CornerRadius="8"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="#330A3F32" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0" />
                                            <GradientStop Color="#F8FFF9" Offset="0.55" />
                                            <GradientStop Color="#DFF3E8" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#F6CD4A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#DCEEE4" Offset="0" />
                                            <GradientStop Color="#EFF9F2" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#C3911C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource WizardButton}">
            <Setter Property="MinHeight" Value="74" />
            <Setter Property="Padding" Value="22,14" />
        </Style>

        <Style x:Key="RaisedPanel" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <SkewTransform AngleX="0" AngleY="0" />
                        <TranslateTransform Y="0" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="34"
                                      ShadowDepth="18"
                                      Direction="270"
                                      Opacity="0.50"
                                      Color="#050707" />
                </Setter.Value>
            </Setter>
            <EventSetter Event="Loaded" Handler="Floating3D_Loaded" />
            <EventSetter Event="MouseEnter" Handler="Component3D_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Component3D_MouseLeave" />
            <EventSetter Event="PreviewMouseDown" Handler="Component3D_MouseDown" />
            <EventSetter Event="PreviewMouseUp" Handler="Component3D_MouseUp" />
        </Style>

        <Style x:Key="StepDot" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#18372F" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="8"
                                      Direction="270"
                                      Opacity="0.32"
                                      Color="#050707" />
                </Setter.Value>
            </Setter>
            <EventSetter Event="Loaded" Handler="Floating3D_Loaded" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.18,0.20"
                                 GradientOrigin="0.12,0.16"
                                 RadiusX="0.95"
                                 RadiusY="0.95">
                <GradientStop Color="#1B6B4E" Offset="0" />
                <GradientStop Color="#10251F" Offset="0.45" />
                <GradientStop Color="#071411" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Border Style="{StaticResource RaisedPanel}"
                Background="#0D6B4F"
                BorderBrush="#D8A531"
                BorderThickness="1"
                CornerRadius="8"
                Padding="28"
                Margin="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource RaisedPanel}"
                            Background="#FFFDF7"
                            CornerRadius="8"
                            Padding="14,10"
                            Width="500"
                            HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="Assets/afranlogo.png"
                                   Height="62"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Left" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SubtitleLabel"
                               Grid.Column="1"
                               Text="Registration kiosk"
                               Foreground="#F1D58A"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="18,0,18,0"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock x:Name="ClockLabel"
                                   Text="00:00"
                                   Foreground="#FFFDF7"
                                   FontSize="34"
                                   FontWeight="Black"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="DateLabel"
                                   Text="Tuesday"
                                   Foreground="#BFE8D5"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,24,0,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="LanguageDot" Style="{StaticResource StepDot}" Background="#D8A531">
                            <TextBlock Text="1" Foreground="#10251F" FontSize="21" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource RaisedPanel}" Height="5" Background="#D8A531" VerticalAlignment="Center" Margin="14,0" />
                        <Border x:Name="GenderDot" Grid.Column="2" Style="{StaticResource StepDot}">
                            <TextBlock Text="2" Foreground="#FFFDF7" FontSize="21" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource RaisedPanel}" Height="5" Background="#D8A531" VerticalAlignment="Center" Margin="14,0" />
                        <Border x:Name="PrintDot" Grid.Column="4" Style="{StaticResource StepDot}">
                            <TextBlock Text="3" Foreground="#FFFDF7" FontSize="21" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,24,0,0">
                        <Grid x:Name="LanguagePanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="StepLabel"
                                           Text="STEP 1 / 2"
                                           Foreground="#F1D58A"
                                           FontSize="16"
                                           FontWeight="Black" />
                                <TextBlock x:Name="TitleLabel"
                                           Text="ቋንቋ ይምረጡ / Afaan filadhu"
                                           Foreground="#FFFDF7"
                                           FontSize="46"
                                           FontWeight="Black"
                                           Margin="0,6,0,0" />
                                <TextBlock x:Name="HelperLabel"
                                           Text="አማርኛ ወይም Afaan Oromoo ይምረጡ።"
                                           Foreground="#DDF4E6"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource WizardButton}"
                                        Margin="0,0,16,0"
                                        Tag="Amharic"
                                        Click="LanguageButton_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="AMRC" Foreground="#D8A531" FontSize="22" FontWeight="Black" />
                                        <TextBlock Text="አማርኛ" Foreground="#10251F" FontSize="46" FontWeight="Black" Margin="0,10,0,2" />
                                        <TextBlock Text="በአማርኛ ይቀጥሉ" Foreground="#5F6F64" FontSize="18" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        Style="{StaticResource WizardButton}"
                                        Margin="16,0,0,0"
                                        Tag="Oromo"
                                        Click="LanguageButton_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="OROMO" Foreground="#D8A531" FontSize="22" FontWeight="Black" />
                                        <TextBlock Text="Afaan Oromoo" Foreground="#10251F" FontSize="46" FontWeight="Black" Margin="0,10,0,2" />
                                        <TextBlock Text="Afaan Oromootiin itti fufi" Foreground="#5F6F64" FontSize="18" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <Grid x:Name="GenderPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="GenderStepLabel"
                                           Text="STEP 2 / 2"
                                           Foreground="#F1D58A"
                                           FontSize="16"
                                           FontWeight="Black" />
                                <TextBlock x:Name="GenderTitleLabel"
                                           Text="Choose gender"
                                           Foreground="#FFFDF7"
                                           FontSize="50"
                                           FontWeight="Black"
                                           Margin="0,6,0,0" />
                                <TextBlock x:Name="GenderHelperLabel"
                                           Text="Ticket prints automatically after selection."
                                           Foreground="#DDF4E6"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource WizardButton}"
                                        Margin="0,0,16,0"
                                        Tag="Female"
                                        Click="GenderButton_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="FemaleCodeLabel" Text="F" Foreground="#D8A531" FontSize="28" FontWeight="Black" />
                                        <TextBlock x:Name="FemaleLabel" Text="Female" Foreground="#10251F" FontSize="48" FontWeight="Black" Margin="0,10,0,2" />
                                        <TextBlock x:Name="FemaleHintLabel" Text="Print female registration ticket" Foreground="#5F6F64" FontSize="18" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        Style="{StaticResource WizardButton}"
                                        Margin="16,0,0,0"
                                        Tag="Male"
                                        Click="GenderButton_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="MaleCodeLabel" Text="M" Foreground="#D8A531" FontSize="28" FontWeight="Black" />
                                        <TextBlock x:Name="MaleLabel" Text="Male" Foreground="#10251F" FontSize="48" FontWeight="Black" Margin="0,10,0,2" />
                                        <TextBlock x:Name="MaleHintLabel" Text="Print male registration ticket" Foreground="#5F6F64" FontSize="18" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <Grid x:Name="PrintingPanel" Visibility="Collapsed">
                            <Border Style="{StaticResource RaisedPanel}"
                                    Background="#FFFDF7"
                                    CornerRadius="8"
                                    Padding="30"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="640">
                                <StackPanel>
                                    <Border Width="88"
                                            Height="88"
                                            CornerRadius="8"
                                            Background="#D8A531"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,18"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                <SkewTransform AngleX="0" AngleY="0" />
                                                <TranslateTransform Y="0" />
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <TextBlock Text="✓"
                                                   Foreground="#10251F"
                                                   FontSize="54"
                                                   FontWeight="Black"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="PrintingTitleLabel"
                                               Text="Thank you"
                                               Foreground="#10251F"
                                               FontSize="40"
                                               FontWeight="Black"
                                               TextAlignment="Center" />
                                    <TextBlock x:Name="TicketLabel"
                                               Text="REG-105"
                                               Foreground="#0D6B4F"
                                               FontSize="62"
                                               FontWeight="Black"
                                               Margin="0,12,0,0"
                                               TextAlignment="Center" />
                                    <Border Background="#EAF7EE"
                                            BorderBrush="#D8A531"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="18"
                                            Margin="0,18,0,0">
                                        <TextBlock x:Name="PrintingWowLabel"
                                                   Text="Your registration ticket is ready."
                                                   Foreground="#10251F"
                                                   FontSize="24"
                                                   FontWeight="Black"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock x:Name="PrintingHelperLabel"
                                               Text="Please take your ticket."
                                               Foreground="#5F6F64"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton"
                            Grid.Column="0"
                            Style="{StaticResource SmallButton}"
                            Width="170"
                            Click="BackButton_Click">
                        <TextBlock x:Name="BackButtonLabel" Text="Back" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Border Grid.Column="1"
                            Style="{StaticResource RaisedPanel}"
                            Background="#0A3F32"
                            CornerRadius="8"
                            Padding="20"
                            Margin="18,0">
                        <TextBlock x:Name="StatusLabel"
                                   Text="Ready for registration."
                                   Foreground="#FFFDF7"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Button Grid.Column="2"
                            Style="{StaticResource SmallButton}"
                            Background="#D8A531"
                            Width="170"
                            Click="ResetButton_Click">
                        <TextBlock x:Name="NewButtonLabel" Text="New" Foreground="#10251F" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
