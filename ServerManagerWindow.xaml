<Window x:Class="AfranHospitalKiosk.ServerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Afran Hospital Server Manager" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Afran Hospital Queue System" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Server Manager" FontSize="16" Foreground="#7F8C8D" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- API Server Control -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,25"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Queue API Server" FontSize="18" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    <TextBlock Text="http://0.0.0.0:5000" FontSize="13" Foreground="#95A5A6" Margin="0,3,0,0"/>
                    <TextBlock x:Name="ApiStatusText" Text="Status: Stopped" FontSize="12" 
                               Foreground="#E74C3C" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>

                <Button x:Name="StartApiButton" Grid.Column="1" 
                        Background="#27AE60" Foreground="White"
                        Content="Start API" Click="StartApiButton_Click" Width="120"/>
            </Grid>
        </Border>

        <!-- Application Launchers -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="25"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Launch Applications" FontSize="18" FontWeight="SemiBold" 
                           Foreground="#2C3E50" Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Kiosk -->
                    <Border Grid.Column="0" Grid.Row="0" Background="#F8F9FA" CornerRadius="8" 
                            Padding="15" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="🏥" FontSize="32" Margin="0,0,0,10"/>
                            <TextBlock Text="Kiosk" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="Patient Registration" FontSize="12" Foreground="#7F8C8D" Margin="0,3,0,10"/>
                            <Button Background="#3498DB" Foreground="White" Content="Launch" 
                                    Click="LaunchKioskButton_Click" Padding="15,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Doctor -->
                    <Border Grid.Column="1" Grid.Row="0" Background="#F8F9FA" CornerRadius="8" 
                            Padding="15" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="👨‍⚕️" FontSize="32" Margin="0,0,0,10"/>
                            <TextBlock Text="Doctor" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="Doctor Station" FontSize="12" Foreground="#7F8C8D" Margin="0,3,0,10"/>
                            <Button Background="#9B59B6" Foreground="White" Content="Launch" 
                                    Click="LaunchDoctorButton_Click" Padding="15,8"/>
                        </StackPanel>
                    </Border>

                    <!-- TV -->
                    <Border Grid.Column="2" Grid.Row="0" Background="#F8F9FA" CornerRadius="8" 
                            Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📺" FontSize="32" Margin="0,0,0,10"/>
                            <TextBlock Text="TV Display" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="Waiting Room" FontSize="12" Foreground="#7F8C8D" Margin="0,3,0,10"/>
                            <Button Background="#E67E22" Foreground="White" Content="Launch" 
                                    Click="LaunchTvButton_Click" Padding="15,8"/>
                        </StackPanel>
                    </Border>

                    <!-- Status indicators -->
                    <TextBlock Grid.Column="0" Grid.Row="1" x:Name="KioskStatusText" 
                               Text="Not running" FontSize="11" Foreground="#95A5A6" 
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" x:Name="DoctorStatusText" 
                               Text="Not running" FontSize="11" Foreground="#95A5A6" 
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Grid.Column="2" Grid.Row="1" x:Name="TvStatusText" 
                               Text="Not running" FontSize="11" Foreground="#95A5A6" 
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Margin="0,25,0,0">
            <Button Background="#E74C3C" Foreground="White" Content="Close All Applications" 
                    Click="CloseAllButton_Click" Width="200" HorizontalAlignment="Center"/>
            <TextBlock Text="Press Escape to close this window" FontSize="11" Foreground="#95A5A6" 
                       HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>
