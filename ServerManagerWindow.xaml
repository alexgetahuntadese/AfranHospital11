<Window x:Class="AfranHospitalKiosk.ServerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Afran Hospital Queue System - Server Manager" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryBlueHover" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#059669"/>
        <SolidColorBrush x:Key="SuccessGreenHover" Color="#047857"/>
        <SolidColorBrush x:Key="DangerRed" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerRedHover" Color="#B91C1C"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#D97706"/>
        <SolidColorBrush x:Key="WarningOrangeHover" Color="#B45309"/>
        <SolidColorBrush x:Key="PurpleAccent" Color="#7C3AED"/>
        <SolidColorBrush x:Key="PurpleAccentHover" Color="#6D28D9"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="BackgroundWhite" Color="#FFFFFF"/>
        
        <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.08" BlurRadius="20" ShadowDepth="0"/>
        <DropShadowEffect x:Key="ButtonShadow" Color="#000000" Opacity="0.15" BlurRadius="8" ShadowDepth="2"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="{StaticResource BackgroundWhite}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Afran Hospital Queue System" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="Enterprise Server Manager" 
                               FontSize="15" 
                               Foreground="{StaticResource TextSecondary}" 
                               Margin="0,4,0,0"
                               FontFamily="Segoe UI"/>
                </StackPanel>
                
                <Border Grid.Column="1" 
                        Background="#DBEAFE" 
                        CornerRadius="20" 
                        Padding="16,8">
                    <TextBlock Text="v2.0" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="#1E40AF"/>
                </Border>
            </Grid>
        </StackPanel>

        <!-- API Server Control -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="32" Margin="0,0,0,32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="#FEF3C7" 
                                CornerRadius="8" 
                                Width="48" 
                                Height="48" 
                                Margin="0,0,16,0">
                            <TextBlock Text="⚡" 
                                       FontSize="24" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Queue API Server" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="http://0.0.0.0:5000" 
                                       FontSize="13" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       Margin="0,2,0,0"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                    
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Ellipse Grid.Column="0" 
                                 Width="10" 
                                 Height="10" 
                                 Fill="#E5E7EB" 
                                 x:Name="ApiStatusIndicator"
                                 Margin="0,0,8,0"/>
                        
                        <TextBlock Grid.Column="1" 
                                   x:Name="ApiStatusText" 
                                   Text="Status: Stopped" 
                                   FontSize="13" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   FontWeight="Medium"
                                   FontFamily="Segoe UI"/>
                    </Grid>
                </StackPanel>

                <Button x:Name="StartApiButton" 
                        Grid.Column="1" 
                        Background="{StaticResource SuccessGreen}" 
                        Content="Start API" 
                        Click="StartApiButton_Click" 
                        Width="140"
                        Margin="24,0,0,0"/>
            </Grid>
        </Border>

        <!-- Application Launchers -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="32">
            <StackPanel>
                <TextBlock Text="Application Launcher" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimary}" 
                           Margin="0,0,0,24"
                           FontFamily="Segoe UI"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Kiosk -->
                    <Border Grid.Column="0" Grid.Row="0" 
                            Background="#F8FAFC" 
                            CornerRadius="10" 
                            Padding="24" 
                            Margin="0,0,16,16"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <StackPanel>
                            <Border Background="#DBEAFE" 
                                    CornerRadius="12" 
                                    Width="56" 
                                    Height="56" 
                                    Margin="0,0,0,16">
                                <TextBlock Text="🏥" 
                                           FontSize="28" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Patient Kiosk" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="Patient Registration Interface" 
                                       FontSize="13" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       Margin="0,4,0,16"
                                       FontFamily="Segoe UI"/>
                            <Button Background="{StaticResource PrimaryBlue}" 
                                    Content="Launch" 
                                    Click="LaunchKioskButton_Click" 
                                    Padding="20,10"/>
                        </StackPanel>
                    </Border>

                    <!-- Doctor -->
                    <Border Grid.Column="1" Grid.Row="0" 
                            Background="#F8FAFC" 
                            CornerRadius="10" 
                            Padding="24" 
                            Margin="0,0,16,16"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <StackPanel>
                            <Border Background="#EDE9FE" 
                                    CornerRadius="12" 
                                    Width="56" 
                                    Height="56" 
                                    Margin="0,0,0,16">
                                <TextBlock Text="👨‍⚕️" 
                                           FontSize="28" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Doctor Station" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="Queue Management Interface" 
                                       FontSize="13" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       Margin="0,4,0,16"
                                       FontFamily="Segoe UI"/>
                            <Button Background="{StaticResource PurpleAccent}" 
                                    Content="Launch" 
                                    Click="LaunchDoctorButton_Click" 
                                    Padding="20,10"/>
                        </StackPanel>
                    </Border>

                    <!-- TV -->
                    <Border Grid.Column="2" Grid.Row="0" 
                            Background="#F8FAFC" 
                            CornerRadius="10" 
                            Padding="24" 
                            Margin="0,0,0,16"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <StackPanel>
                            <Border Background="#FEF3C7" 
                                    CornerRadius="12" 
                                    Width="56" 
                                    Height="56" 
                                    Margin="0,0,0,16">
                                <TextBlock Text="📺" 
                                           FontSize="28" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TV Display" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="Waiting Room Display" 
                                       FontSize="13" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       Margin="0,4,0,16"
                                       FontFamily="Segoe UI"/>
                            <Button Background="{StaticResource WarningOrange}" 
                                    Content="Launch" 
                                    Click="LaunchTvButton_Click" 
                                    Padding="20,10"/>
                        </StackPanel>
                    </Border>

                    <!-- Status indicators -->
                    <Grid Grid.Column="0" Grid.Row="1" Margin="0,8,0,0">
                        <Ellipse Width="8" Height="8" Fill="#E5E7EB" x:Name="KioskStatusDot"/>
                        <TextBlock x:Name="KioskStatusText" 
                                   Text="Not running" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   Margin="16,0,0,0"
                                   FontFamily="Segoe UI"/>
                    </Grid>
                    <Grid Grid.Column="1" Grid.Row="1" Margin="0,8,0,0">
                        <Ellipse Width="8" Height="8" Fill="#E5E7EB" x:Name="DoctorStatusDot"/>
                        <TextBlock x:Name="DoctorStatusText" 
                                   Text="Not running" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   Margin="16,0,0,0"
                                   FontFamily="Segoe UI"/>
                    </Grid>
                    <Grid Grid.Column="2" Grid.Row="1" Margin="0,8,0,0">
                        <Ellipse Width="8" Height="8" Fill="#E5E7EB" x:Name="TvStatusDot"/>
                        <TextBlock x:Name="TvStatusText" 
                                   Text="Not running" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   Margin="16,0,0,0"
                                   FontFamily="Segoe UI"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Margin="0,32,0,0">
            <Button Background="{StaticResource DangerRed}" 
                    Content="Close All Applications" 
                    Click="CloseAllButton_Click" 
                    Width="220" 
                    HorizontalAlignment="Center"
                    Padding="24,12"/>
            <TextBlock Text="Press Escape to close this window" 
                       FontSize="12" 
                       Foreground="{StaticResource TextSecondary}" 
                       HorizontalAlignment="Center" 
                       Margin="0,16,0,0"
                       FontFamily="Segoe UI"/>
        </StackPanel>
    </Grid>
</Window>
