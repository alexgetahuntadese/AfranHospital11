<Window x:Class="AfranHospitalKiosk.TvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Afran Hospital TV Queue Display"
        Width="1366"
        Height="768"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#07131F"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#1D7894" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#0B2133" />
        </Style>
        <Style x:Key="RoomCard" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,9" />
        </Style>
    </Window.Resources>

    <Border Background="#111" Padding="12">
        <Grid Background="#07131F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.18*" />
                <ColumnDefinition Width="0.82*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D2C52" Offset="0" />
                        <GradientStop Color="#0D4C72" Offset="0.42" />
                        <GradientStop Color="#081928" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>

                <Image x:Name="SlideImage"
                       Stretch="UniformToFill"
                       Opacity="0.92"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#DB07131F" Offset="0" />
                            <GradientStop Color="#8A0D2C52" Offset="0.54" />
                            <GradientStop Color="#C707131F" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="34,28,34,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="Assets/afranlogo.png"
                               Width="250"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" Margin="18,4,0,0">
                            <TextBlock Text="AFRAN HOSPITAL" Foreground="#F8FBFF" FontSize="36" FontWeight="Black" />
                            <TextBlock Text="Compassion - Care - Community" Foreground="#DDEBFA" FontSize="20" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="18,70,0,0">
                        <TextBlock Text="WELCOME TO" Foreground="#F8FBFF" FontSize="34" />
                        <TextBlock Text="ADDIS ABABA" Foreground="#F8FBFF" FontSize="70" FontWeight="Black" />
                        <TextBlock Text="A CITY OF UNITY," Foreground="#F8FBFF" FontSize="28" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock Text="HERITAGE &amp; PROGRESS" Foreground="#F8FBFF" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="#CC07131F"
                            CornerRadius="8"
                            Padding="24"
                            Width="430"
                            HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Addis Ababa" Foreground="#14E3C2" FontSize="34" FontStyle="Italic" />
                            <TextBlock Text="The heart of Ethiopia" Foreground="#F8FBFF" FontSize="20" Margin="0,8,0,0" />
                            <TextBlock Text="A city that inspires and grows together." Foreground="#F8FBFF" FontSize="18" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="#061522" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DateLabel" Text="Tuesday, Jun 09, 2026" Foreground="#F8FBFF" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Registration Queue" Foreground="#8FC9DC" FontSize="15" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="#14E3C2" Margin="26,4" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="ClockLabel" Text="10:45" Foreground="#F8FBFF" FontSize="42" FontWeight="Black" />
                            <TextBlock Text=" Addis Ababa" Foreground="#DDEBFA" FontSize="16" VerticalAlignment="Center" Margin="18,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="28" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="NOW SERVING" Foreground="#F8FBFF" FontSize="44" FontWeight="Black" TextAlignment="Center" />
                                <TextBlock Text="Current patient called to registration" Foreground="#8FC9DC" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Row="1" CornerRadius="8" Margin="0,26,0,24">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#31D66F" Offset="0" />
                                        <GradientStop Color="#006B4D" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="NowServingLabel" Text="-" Foreground="#F8FBFF" FontSize="176" FontWeight="Black" TextAlignment="Center" />
                                    <Border Background="#D8FFF5" CornerRadius="8" Padding="18,12" Margin="48,10">
                                        <TextBlock Text="GO TO ROOM 3" Foreground="#063A30" FontSize="34" FontWeight="Black" TextAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.08*" />
                                    <ColumnDefinition Width="0.92*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Panel}" Padding="18" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="NEXT PATIENT" Foreground="#14E3C2" FontSize="21" FontWeight="Black" />
                                        <TextBlock Text="First waiting ticket" Foreground="#8FC9DC" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        <Border CornerRadius="8" Background="#064F90" Padding="18" Margin="0,10,0,0">
                                            <TextBlock x:Name="NextTicket1" Text="-" Foreground="#F8FBFF" FontSize="56" FontWeight="Black" TextAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="18" Margin="12,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="COUNTERS" Foreground="#14E3C2" FontSize="21" FontWeight="Black" />
                                        <Border Style="{StaticResource RoomCard}" Background="#087660" Margin="0,10,0,8">
                                            <Grid>
                                                <TextBlock Text="Now" Foreground="#F8FBFF" FontSize="20" FontWeight="Bold" />
                                                <TextBlock x:Name="RoomTicket3" Text="-" Foreground="#F8FBFF" FontSize="34" FontWeight="Black" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource RoomCard}" Margin="0,8,0,0">
                                            <Grid>
                                                <TextBlock Text="After next" Foreground="#F8FBFF" FontSize="20" FontWeight="Bold" />
                                                <TextBlock x:Name="RoomTicket1" Text="-" Foreground="#F8FBFF" FontSize="34" FontWeight="Black" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="TickerLabel" />
                <TextBlock x:Name="RoomTicket2" />
                <TextBlock x:Name="RoomTicket4" />
                <TextBlock x:Name="RoomTicket5" />
                <TextBlock x:Name="QueueGender1" />
                <TextBlock x:Name="QueueTicket1" />
                <TextBlock x:Name="QueueGender2" />
                <TextBlock x:Name="QueueTicket2" />
                <TextBlock x:Name="QueueGender3" />
                <TextBlock x:Name="QueueTicket3" />
                <TextBlock x:Name="QueueGender4" />
                <TextBlock x:Name="QueueTicket4" />
                <TextBlock x:Name="QueueGender5" />
                <TextBlock x:Name="QueueTicket5" />
                <TextBlock x:Name="QueueGender6" />
                <TextBlock x:Name="QueueTicket6" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
