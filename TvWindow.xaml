<Window x:Class="AfranHospitalKiosk.TvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Afran Hospital TV Queue Display"
        Width="1366"
        Height="768"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#07131F"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#1D7894" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#0B2133" />
        </Style>
        <Style x:Key="RoomCard" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,9" />
        </Style>
    </Window.Resources>

    <Border Background="#111" Padding="12">
        <Grid Background="#07131F">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="WaitingStripRow" Height="132" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Background="#000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="118" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#000" Padding="28,12">
                    <Image Source="Assets/afranlogo.png"
                           Height="84"
                           MaxWidth="620"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <MediaElement x:Name="CorridorVideo"
                              Grid.Row="1"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              Stretch="Uniform"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Opacity="1"
                              IsMuted="True"
                              Volume="0"
                              MediaEnded="CorridorVideo_MediaEnded" />
            </Grid>

            <Border Grid.Row="0" Grid.Column="1" Background="#061522" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DateLabel" Text="Tuesday, Jun 09, 2026" Foreground="#F8FBFF" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Registration Queue" Foreground="#8FC9DC" FontSize="15" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Background="#14E3C2" Margin="26,4" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="ClockLabel" Text="10:45" Foreground="#F8FBFF" FontSize="42" FontWeight="Black" />
                            <TextBlock Text=" Addis Ababa" Foreground="#DDEBFA" FontSize="16" VerticalAlignment="Center" Margin="18,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="24" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="330" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="NOW SERVING" Foreground="#F8FBFF" FontSize="44" FontWeight="Black" TextAlignment="Center" />

                            <Border Grid.Row="1" CornerRadius="8" Margin="0,18,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#31D66F" Offset="0" />
                                        <GradientStop Color="#006B4D" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Margin="24,18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both">
                                        <TextBlock x:Name="NowServingLabel" Text="-" Foreground="#F8FBFF" FontSize="180" FontWeight="Black" TextAlignment="Center" LineHeight="180" />
                                    </Viewbox>
                                    <Border Grid.Row="1" Background="#D8FFF5" CornerRadius="8" Padding="18,10" Margin="48,10,48,0">
                                        <TextBlock x:Name="RoomDisplayLabel" Text="GO TO GCC OPD ROOM -" Foreground="#063A30" FontSize="34" FontWeight="Black" TextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="WaitingStrip" Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="8" Padding="18" Margin="0,12,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#31D66F" Offset="0" />
                        <GradientStop Color="#006B4D" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="NextPatientsTitle" Text="NEXT PATIENTS" Foreground="#F8FBFF" FontSize="28" FontWeight="Black" VerticalAlignment="Center" Margin="8,0,24,0" />

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="8" Background="#F8FBFF" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="1" Foreground="#006B4D" FontSize="16" FontWeight="Black" TextAlignment="Center" />
                                <TextBlock x:Name="QueueTicket1" Text="-" Foreground="#006B4D" FontSize="34" FontWeight="Black" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="8" Background="#D8FFF5" Padding="12,8" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="2" Foreground="#006B4D" FontSize="16" FontWeight="Black" TextAlignment="Center" />
                                <TextBlock x:Name="QueueTicket2" Text="-" Foreground="#006B4D" FontSize="34" FontWeight="Black" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="8" Background="#D8FFF5" Padding="12,8" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="3" Foreground="#006B4D" FontSize="16" FontWeight="Black" TextAlignment="Center" />
                                <TextBlock x:Name="QueueTicket3" Text="-" Foreground="#006B4D" FontSize="34" FontWeight="Black" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" CornerRadius="8" Background="#D8FFF5" Padding="12,8" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="4" Foreground="#006B4D" FontSize="16" FontWeight="Black" TextAlignment="Center" />
                                <TextBlock x:Name="QueueTicket4" Text="-" Foreground="#006B4D" FontSize="34" FontWeight="Black" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" CornerRadius="8" Background="#D8FFF5" Padding="12,8" Margin="8,0">
                            <StackPanel>
                                <TextBlock Text="5" Foreground="#006B4D" FontSize="16" FontWeight="Black" TextAlignment="Center" />
                                <TextBlock x:Name="QueueTicket5" Text="-" Foreground="#006B4D" FontSize="34" FontWeight="Black" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="5" CornerRadius="8" Background="#D8FFF5" Padding="12,8" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="6" Foreground="#006B4D" FontSize="16" FontWeight="Black" TextAlignment="Center" />
                                <TextBlock x:Name="QueueTicket6" Text="-" Foreground="#006B4D" FontSize="34" FontWeight="Black" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="TickerLabel" />
                <TextBlock x:Name="RoomTicket1" />
                <TextBlock x:Name="RoomTicket2" />
                <TextBlock x:Name="RoomTicket3" />
                <TextBlock x:Name="RoomTicket4" />
                <TextBlock x:Name="RoomTicket5" />
                <TextBlock x:Name="QueueGender1" />
                <TextBlock x:Name="QueueGender2" />
                <TextBlock x:Name="QueueGender3" />
                <TextBlock x:Name="QueueGender4" />
                <TextBlock x:Name="QueueGender5" />
                <TextBlock x:Name="QueueGender6" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
