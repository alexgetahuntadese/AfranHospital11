<Window x:Class="AfranHospitalKiosk.DoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Afran Hospital Doctor Station"
        Width="1366"
        Height="768"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#10251F"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="RaisedPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="14" Direction="270" Opacity="0.42" Color="#050707" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="#FFFDF7" />
            <Setter Property="Foreground" Value="#10251F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D8A531" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F6FFF9" />
                                <Setter Property="BorderBrush" Value="#F1D58A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DDF4E6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.18,0.20" GradientOrigin="0.12,0.16" RadiusX="0.95" RadiusY="0.95">
                <GradientStop Color="#1B6B4E" Offset="0" />
                <GradientStop Color="#10251F" Offset="0.45" />
                <GradientStop Color="#071411" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Border Style="{StaticResource RaisedPanel}" Background="#0D6B4F" BorderBrush="#D8A531" BorderThickness="1" Padding="28" Margin="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource RaisedPanel}" Background="#FFFDF7" Padding="14,10" Width="500">
                        <Image Source="Assets/afranlogo.png" Height="62" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Doctor station" Foreground="#F1D58A" FontSize="17" FontWeight="Black" />
                        <TextBlock Text="Registration queue control" Foreground="#FFFDF7" FontSize="34" FontWeight="Black" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock x:Name="ClockLabel" Text="00:00" Foreground="#FFFDF7" FontSize="34" FontWeight="Black" HorizontalAlignment="Right" />
                        <TextBlock x:Name="DateLabel" Text="Tuesday" Foreground="#BFE8D5" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.18*" />
                        <ColumnDefinition Width="0.82*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource RaisedPanel}" Background="#FFFDF7" Padding="30" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Patient queue" Foreground="#10251F" FontSize="38" FontWeight="Black" />
                            <Grid Grid.Row="1" Margin="0,24,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Ticket" Foreground="#5F6F64" FontSize="15" FontWeight="Black" />
                                <TextBlock Grid.Column="1" Text="Language" Foreground="#5F6F64" FontSize="15" FontWeight="Black" />
                                <TextBlock Grid.Column="2" Text="Gender" Foreground="#5F6F64" FontSize="15" FontWeight="Black" />

                                <TextBlock x:Name="QueueTicket1" Grid.Row="1" Text="-" Foreground="#0D6B4F" FontSize="30" FontWeight="Black" VerticalAlignment="Center" />
                                <TextBlock x:Name="QueueLanguage1" Grid.Row="1" Grid.Column="1" Text="-" Foreground="#10251F" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock x:Name="QueueGender1" Grid.Row="1" Grid.Column="2" Text="-" Foreground="#10251F" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />

                                <TextBlock x:Name="QueueTicket2" Grid.Row="2" Text="-" Foreground="#0D6B4F" FontSize="30" FontWeight="Black" VerticalAlignment="Center" />
                                <TextBlock x:Name="QueueLanguage2" Grid.Row="2" Grid.Column="1" Text="-" Foreground="#10251F" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock x:Name="QueueGender2" Grid.Row="2" Grid.Column="2" Text="-" Foreground="#10251F" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />

                                <TextBlock x:Name="QueueTicket3" Grid.Row="3" Text="-" Foreground="#0D6B4F" FontSize="30" FontWeight="Black" VerticalAlignment="Center" />
                                <TextBlock x:Name="QueueLanguage3" Grid.Row="3" Grid.Column="1" Text="-" Foreground="#10251F" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock x:Name="QueueGender3" Grid.Row="3" Grid.Column="2" Text="-" Foreground="#10251F" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource RaisedPanel}" Background="#0A3F32" BorderBrush="#D8A531" BorderThickness="1" Padding="30">
                            <StackPanel>
                                <TextBlock Text="NOW CALLING" Foreground="#F1D58A" FontSize="16" FontWeight="Black" />
                                <TextBlock x:Name="NowCallingLabel" Text="REG-105" Foreground="#FFFDF7" FontSize="76" FontWeight="Black" Margin="0,12,0,0" />
                                <TextBlock x:Name="RoomLabel" Text="Registration Room 2" Foreground="#DDF4E6" FontSize="24" FontWeight="SemiBold" />
                                <Border Background="#D8A531" Padding="18" Margin="0,30,0,0">
                                    <TextBlock Text="Ready for doctor review" Foreground="#10251F" FontSize="22" FontWeight="Black" TextAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,22,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button x:Name="CallNextButton" Style="{StaticResource ActionButton}" Click="CallNext_Click">
                                <TextBlock Text="Call next" FontSize="26" FontWeight="Black" TextAlignment="Center" />
                            </Button>
                            <Button x:Name="RecallButton" Grid.Row="1" Style="{StaticResource ActionButton}" Background="#D8A531" Margin="0,14,0,0" Click="Recall_Click">
                                <TextBlock Text="Recall ticket" FontSize="26" FontWeight="Black" TextAlignment="Center" />
                            </Button>
                            <Button x:Name="CompleteButton" Grid.Row="2" Style="{StaticResource ActionButton}" Background="#EAF7EE" Margin="0,14,0,0" Click="Complete_Click">
                                <TextBlock Text="Complete + next" FontSize="26" FontWeight="Black" TextAlignment="Center" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
