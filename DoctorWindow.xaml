<Window x:Class="AfranHospitalKiosk.DoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Afran Hospital Doctor Station"
        Width="1366"
        Height="768"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#F3F8FF"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#102A43" />
        <SolidColorBrush x:Key="MutedBrush" Color="#59758E" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#1D74D8" />
        <SolidColorBrush x:Key="BlueBrush" Color="#0B5CAD" />
        <SolidColorBrush x:Key="BrightBlueBrush" Color="#2F80ED" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SoftBlueBrush" Color="#EAF3FF" />
        <SolidColorBrush x:Key="LineBrush" Color="#CFE3F8" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.11" Color="#2A5D91" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.90" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8FBFF" Offset="0" />
                <GradientStop Color="#EEF6FF" Offset="0.55" />
                <GradientStop Color="#E3F0FF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#DDEEFF" Height="132" VerticalAlignment="Top" />
        <Border Background="#0B5CAD" Width="8" HorizontalAlignment="Left" />

        <Grid Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Panel}" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#F8FBFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16,8" Width="390">
                        <Image Source="Assets/afranlogo.png" Height="70" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Doctor station" Foreground="{StaticResource AccentBlueBrush}" FontSize="18" FontWeight="Black" />
                        <TextBlock Text="Clinical consultation queue" Foreground="{StaticResource InkBrush}" FontSize="36" FontWeight="Black" />
                        <TextBlock Text="Call ticket numbers, recall tickets, and keep the clinic flow moving." Foreground="{StaticResource MutedBrush}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockLabel" Text="00:00" Foreground="{StaticResource InkBrush}" FontSize="36" FontWeight="Black" HorizontalAlignment="Right" />
                        <TextBlock x:Name="DateLabel" Text="Tuesday" Foreground="{StaticResource MutedBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.16*" />
                    <ColumnDefinition Width="0.84*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Panel}" Padding="30" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Waiting tickets" Foreground="{StaticResource InkBrush}" FontSize="36" FontWeight="Black" />
                                <TextBlock Text="Ticket numbers ready for doctor consultation" Foreground="{StaticResource MutedBrush}" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#EAF3FF" BorderBrush="#B8D9F8" BorderThickness="1" CornerRadius="8" Padding="16,10" VerticalAlignment="Center">
                                <TextBlock Text="ROOM 3" Foreground="{StaticResource AccentBlueBrush}" FontSize="18" FontWeight="Black" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource SoftBlueBrush}" CornerRadius="8" Padding="18,14" Margin="0,24,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ticket" Foreground="{StaticResource MutedBrush}" FontSize="15" FontWeight="Black" />
                                <TextBlock Grid.Column="1" Text="Language" Foreground="{StaticResource MutedBrush}" FontSize="15" FontWeight="Black" />
                                <TextBlock Grid.Column="2" Text="Gender" Foreground="{StaticResource MutedBrush}" FontSize="15" FontWeight="Black" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" />
                            <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" />

                            <TextBlock x:Name="QueueTicket1" Grid.Row="0" Text="-" Foreground="{StaticResource BlueBrush}" FontSize="32" FontWeight="Black" VerticalAlignment="Center" />
                            <TextBlock x:Name="QueueLanguage1" Grid.Row="0" Grid.Column="1" Text="-" Foreground="{StaticResource InkBrush}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="QueueGender1" Grid.Row="0" Grid.Column="2" Text="-" Foreground="{StaticResource InkBrush}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />

                            <TextBlock x:Name="QueueTicket2" Grid.Row="1" Text="-" Foreground="{StaticResource BlueBrush}" FontSize="32" FontWeight="Black" VerticalAlignment="Center" />
                            <TextBlock x:Name="QueueLanguage2" Grid.Row="1" Grid.Column="1" Text="-" Foreground="{StaticResource InkBrush}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="QueueGender2" Grid.Row="1" Grid.Column="2" Text="-" Foreground="{StaticResource InkBrush}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />

                            <TextBlock x:Name="QueueTicket3" Grid.Row="2" Text="-" Foreground="{StaticResource BlueBrush}" FontSize="32" FontWeight="Black" VerticalAlignment="Center" />
                            <TextBlock x:Name="QueueLanguage3" Grid.Row="2" Grid.Column="1" Text="-" Foreground="{StaticResource InkBrush}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="QueueGender3" Grid.Row="2" Grid.Column="2" Text="-" Foreground="{StaticResource InkBrush}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Panel}" Padding="30">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="NOW CALLING" Foreground="{StaticResource AccentBlueBrush}" FontSize="17" FontWeight="Black" />
                                <TextBlock Text="Current ticket number for consultation" Foreground="{StaticResource MutedBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1" Background="#F0F7FF" BorderBrush="#B8D9F8" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,22,0,22">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="NowCallingLabel" Text="-" Foreground="{StaticResource BrightBlueBrush}" FontSize="82" FontWeight="Black" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="RoomLabel" Text="Doctor Room 3" Foreground="{StaticResource InkBrush}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Background="#E3F0FF" BorderBrush="#B8D9F8" BorderThickness="1" CornerRadius="8" Padding="18">
                                <TextBlock Text="Ready for doctor review by ticket number" Foreground="{StaticResource BlueBrush}" FontSize="22" FontWeight="Black" TextAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button x:Name="CallNextButton" Style="{StaticResource ActionButton}" Click="CallNext_Click">
                            <TextBlock Text="Call next ticket" FontSize="25" FontWeight="Black" TextAlignment="Center" />
                        </Button>
                        <Button x:Name="RecallButton" Grid.Row="1" Style="{StaticResource ActionButton}" Background="{StaticResource BlueBrush}" Margin="0,14,0,0" Click="Recall_Click">
                            <TextBlock Text="Recall ticket" FontSize="25" FontWeight="Black" TextAlignment="Center" />
                        </Button>
                        <Button x:Name="CompleteButton" Grid.Row="2" Style="{StaticResource ActionButton}" Background="{StaticResource BrightBlueBrush}" Margin="0,14,0,0" Click="Complete_Click">
                            <TextBlock Text="Complete and call next" FontSize="25" FontWeight="Black" TextAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
